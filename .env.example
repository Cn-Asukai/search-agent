# ══════════════════════════════════════════════════════════════
# search-agent 环境变量(复制为 .env 后按需修改;全部有默认值)
# ══════════════════════════════════════════════════════════════

# HTTP 服务
PORT=8787
HOST=0.0.0.0

# ── 内嵌 opencode serve 监听(本服务启动时自动 spawn)────────
# 端口 0(默认)= 随机空闲端口,避免与其他服务冲突(如 VS Code Kilo 扩展占用 4096)
# OPENCODE_HOSTNAME=127.0.0.1
# OPENCODE_PORT=0

# ── 模型(自定义 OpenAI 兼容网关)────────────────────────────
# 不绑定厂商或具体模型。三者都填后走 opencode 的 custom/default。
# LLM_BASE_URL 通常以 /v1 结尾,例如 https://api.example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 高级:覆盖 OpenCode 内部模型 id(默认 custom/default)
# OPENCODE_MODEL=custom/default

# 使用的 agent 名(对应 opencode.jsonc 中 agent.<name>),一般不用改
# OPENCODE_AGENT=hanhua-search

# ── 任务执行 ──────────────────────────────────────────────────
# 单任务超时(毫秒,默认 10 分钟)
# TASK_TIMEOUT_MS=600000
# 并发检索任务上限(默认 3,超出排队)
# MAX_CONCURRENCY=3
# 同步接口最长等待(毫秒,默认 30 分钟,超时返回 202 + 任务 ID)
# SYNC_MAX_WAIT_MS=1800000
# 任务与原始 opencode 链路(SQLite)。默认 ./data/search-agent.sqlite
# SQLITE_PATH=./data/search-agent.sqlite

# ── 鉴权(可选)──────────────────────────────────────────────
# 设置后,/api/* 需要 Authorization: Bearer <key>
# API_AUTH_KEY=change-me

# ── websearch-mcpserver ────────────────────────────────────
# Docker compose 下三处必须同时开:本变量、websearch.config.yaml 的 auth_token、
# opencode.jsonc 的 Authorization header。空值仍可能不鉴权。
# 仓库内 yaml 仅给 compose 内网用,禁止当裸金属配置。
WEBSEARCH_TOKEN=change-me-websearch

# ── Docker 部署(docker compose 读取)────────────────────────
# agent HTTP 本机端口(compose 默认只绑 127.0.0.1;对外走 nginx)
AGENT_PORT=8787
# websearch 调试端口(默认仅绑定 127.0.0.1:8338)
WEBSEARCH_PORT=8338
# 前端 Vite 开发服务对外端口(仅 docker-compose.dev.yml，默认 5173)
WEB_PORT=5173
# 镜像 tag(默认 latest)
# AGENT_IMAGE_TAG=latest
# WEBSEARCH_IMAGE_TAG=latest
TZ=Asia/Shanghai
