# ══════════════════════════════════════════════════════════════
# search-agent 环境变量(复制为 .env 后按需修改;全部有默认值)
# ══════════════════════════════════════════════════════════════

# HTTP 服务
PORT=8787
HOST=0.0.0.0

# ── opencode 接入方式(二选一)────────────────────────────────
# 外部模式:指向已运行的 `opencode serve`(需在项目根目录启动,以加载 opencode.jsonc)
# 示例:opencode serve --port 7777  →  OPENCODE_BASE_URL=http://127.0.0.1:7777
# 留空 = 内嵌模式:服务自动 spawn `opencode serve`(要求 opencode CLI 在 PATH 中)
# OPENCODE_BASE_URL=http://127.0.0.1:7777

# 内嵌模式的 opencode server 监听地址与端口
# 端口 0(默认)= 随机空闲端口,避免与其他服务冲突(如 VS Code Kilo 扩展占用 4096)
# OPENCODE_HOSTNAME=127.0.0.1
# OPENCODE_PORT=0

# ── 模型(可选)──────────────────────────────────────────────
# 强制指定模型,格式 provider/model-id;留空则用 opencode.jsonc 的 model 配置
# OPENCODE_MODEL=zai/glm-4.7

# 使用的 agent 名(对应 opencode.jsonc 中 agent.<name>),一般不用改
# OPENCODE_AGENT=hanhua-search

# ── 任务执行 ──────────────────────────────────────────────────
# 单任务超时(毫秒,默认 5 分钟)
# TASK_TIMEOUT_MS=300000
# 并发检索任务上限(默认 3,超出排队)
# MAX_CONCURRENCY=3
# 同步接口最长等待(毫秒,默认 30 分钟,超时返回 202 + 任务 ID)
# SYNC_MAX_WAIT_MS=1800000

# ── 鉴权(可选)──────────────────────────────────────────────
# 设置后,/api/* 需要 Authorization: Bearer <key>
# API_AUTH_KEY=change-me

# ── websearch-mcpserver(可选)───────────────────────────────
# 仅当你在 websearch-mcpserver 的 websearch.config.yaml 里配置了 auth_token 时才需要:
# 需同时取消 opencode.jsonc 中 mcp.websearch.headers 的注释
# WEBSEARCH_TOKEN=your-token
