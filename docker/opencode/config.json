{
  "$schema": "https://opencode.ai/config.json",

  // ══════════════════════════════════════════════════════════════════
  // ① 全局模型 provider(必填:镜像内不执行 `opencode auth login`)
  //
  //    把本机 `opencode auth login` 产出的凭据搬进容器:
  //      - 官方 provider(如 anthropic / openai / deepseek 等):把 auth.json 里
  //        对应 provider 的 API key 填到下方 provider.<name>.options.apiKey,
  //        npm 保持默认(@ai-sdk/<provider> 自动解析,一般不用写)。
  //      - 自定义 provider(如示例 taotoken,走 OpenAI/Anthropic 兼容网关):
  //        需按本机 ~/.config/opencode/config.json 的写法声明
  //        npm + baseURL + models 清单,本示例即取自本机实际配置。
  //
  //    密钥通过 docker compose 的环境变量注入,避免写死进镜像:
  //    compose 中把 OPENCODE_MODEL 设为 <provider>/<model>(与下方 models 清单一致),
  //    provider 的 apiKey 用 env 引用(见 compose 里 environment 注入的对应 key)。
  // ══════════════════════════════════════════════════════════════════
  "provider": {
    "taotoken": {
      "name": "TaoToken",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://taotoken.net/api/v1",
        "apiKey": "{env:TAOTOKEN_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": { "context": 120000, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  }
}
