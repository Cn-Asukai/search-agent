# ══════════════════════════════════════════════════════════════
# docker compose 环境变量(复制为 .env 后按需修改)
# 用法:cp .env.example .env && docker compose up -d --build
# ══════════════════════════════════════════════════════════════

# ── 模型(必填)──────────────────────────────────────────────
# 强制指定模型,格式 <provider>/<model>。
# provider 定义在 docker/opencode/config.json(默认内置 taotoken/deepseek-v4-pro)。
# 如需换其他 provider:在 docker/opencode/config.json 里加 provider,再改这里。
OPENCODE_MODEL=taotoken/deepseek-v4-pro

# provider 的 API key(替换成你自己的;对应 config.json 中 {env:TAOTOKEN_API_KEY})
TAOTOKEN_API_KEY=

# ── 端口(可选)──────────────────────────────────────────────
# agent HTTP 服务对外端口(默认 8787)
AGENT_PORT=8787
# websearch 调试端口(默认仅绑定 127.0.0.1:8338)
WEBSEARCH_PORT=8338

# ── API 鉴权(可选)──────────────────────────────────────────
# 设置后 agent 的 /api/* 需要 Authorization: Bearer <key>
# API_AUTH_KEY=

# ── 时区(可选)──────────────────────────────────────────────
TZ=Asia/Shanghai

# ── websearch 鉴权(可选)────────────────────────────────────
# 若要开启 websearch 业务端点鉴权:设置此值,并同步取消
# docker/opencode/opencode.jsonc 中 mcp.websearch.headers 注释
# WEBSEARCH_TOKEN=
