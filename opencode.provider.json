{
  "$schema": "https://opencode.ai/config.json",

  // 通用自定义模型网关(镜像内不执行 `opencode auth login`)。
  // 通过环境变量注入,不绑定任何厂商或具体模型:
  //   LLM_BASE_URL  API 根地址,通常以 /v1 结尾
  //   LLM_API_KEY   API key
  //   LLM_MODEL     发给上游的模型名
  // OpenCode 侧固定使用 custom/default;真正发给上游的 id 是 LLM_MODEL。
  "provider": {
    "custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Custom",
      "env": ["LLM_API_KEY"],
      "options": {
        "baseURL": "{env:LLM_BASE_URL}",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "default": {
          "modelID": "{env:LLM_MODEL}",
          "name": "{env:LLM_MODEL}",
          "limit": { "context": 128000, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  }
}
